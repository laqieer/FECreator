{
  "$defs": {
    "AssetMetadata": {
      "additionalProperties": false,
      "properties": {
        "license_note": {
          "title": "License Note",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "requested_downstream_profile": {
          "anyOf": [
            {
              "const": "fe8-dialogue-background-feimg2",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Downstream Profile"
        },
        "source": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "source_note": {
          "title": "Source Note",
          "type": "string"
        }
      },
      "required": [
        "name",
        "purpose",
        "source",
        "license_note",
        "source_note"
      ],
      "title": "AssetMetadata",
      "type": "object"
    },
    "EditSpec": {
      "additionalProperties": false,
      "properties": {
        "mask_path": {
          "title": "Mask Path",
          "type": "string"
        },
        "protected_regions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Region"
          },
          "title": "Protected Regions",
          "type": "array"
        }
      },
      "required": [
        "mask_path"
      ],
      "title": "EditSpec",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "exclusiveMinimum": 0,
          "title": "H",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "w": {
          "exclusiveMinimum": 0,
          "title": "W",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "label"
      ],
      "title": "Region",
      "type": "object"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "SourceIdentity",
      "type": "object"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "concept_art",
            "approved_portrait",
            "approved_dialogue_background"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "SourceSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_type": {
      "enum": [
        "portrait",
        "dialogue_background"
      ],
      "title": "Asset Type",
      "type": "string"
    },
    "character_ref_pack": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Character Ref Pack"
    },
    "character_ref_pack_rev": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Character Ref Pack Rev"
    },
    "edit": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "params": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Params",
      "type": "object"
    },
    "parent_asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Asset Id"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceSpec"
      },
      "title": "Sources",
      "type": "array"
    },
    "target_spec": {
      "enum": [
        "fe-gba-portrait-standard",
        "fe8-dialogue-background-source-240x160"
      ],
      "title": "Target Spec",
      "type": "string"
    },
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "workflow": {
      "enum": [
        "text_to_portrait",
        "concept_to_portrait",
        "expression_refine",
        "masked_variant",
        "text_to_dialogue_background",
        "concept_to_dialogue_background"
      ],
      "title": "Workflow",
      "type": "string"
    }
  },
  "required": [
    "asset_type",
    "target_spec",
    "workflow",
    "provider"
  ],
  "title": "Manifest",
  "type": "object"
}
